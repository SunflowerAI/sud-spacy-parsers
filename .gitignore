# Python / build
.venv/
__pycache__/
*.egg-info/
build/
# spacy package staging dirs (e.g. build_lzh/)
build_*/
dist/
wheelbuild/
*.tgz
# downloaded deps + built wheels (models ship via GitHub Releases, not in-repo)
*.whl

# Raw SUD treebanks — re-download from https://grew.fr/download/ (see README).
# The relabelled derivatives + each LICENSE.txt are force-added (git add -f).
assets/SUD_English-EWT/
assets/SUD_English-GUM/
assets_zh/SUD_Chinese-GSDSimp/
assets_zh/SUD_Chinese-GSD/
assets_ko/SUD_Korean-GSD/
assets_id/SUD_Indonesian-GSD/

# Dual-script (simplified+traditional) build dirs. zh = GSD + GSDSimp combined;
# lzh = Kyoto + its OpenCC-t2s simplified copy. Regenerate with both_scripts_release.sh.
assets_zh/SUD_Chinese-GSDBoth/
assets_lzh/SUD_Classical_Chinese-Kyoto-Hans/
assets_lzh/SUD_Classical_Chinese-Kyoto-Both/

# GUM is CC BY-NC-SA (NonCommercial) — the English model/data ship EWT-only.
# Exclude every GUM-mixed English artifact; only assets/en_ewt-sud-*.relabeled*.conllu is published.
assets/en_sud-*.conllu
gold_udep.jsonl
metrics.json
metrics_relabeled.json
metrics_en_ext.json

# Trained parsers are distributed as release wheels, not committed.
training_*/

# pkuseg segmenter model — regenerate with scripts/train_pkuseg_zh.py.
models/

# Build artifacts / logs
corpus_*/
*.log
# scratch --review output; the hand-corrections live in sa_ufal_csl_overrides.tsv
sa_ufal_csl_review.tsv

# one-off / scratch driver scripts (not part of the reproducible pipeline)
scripts/finish_phase4.sh
scripts/overnight_arla_ext.sh
scripts/retrain_trimmed.sh
scripts/run_japanese.sh

# New-language raw SUD treebanks — re-download from https://grew.fr/download/ (see README).
assets_fa/SUD_Persian-PerDT/
assets_ar/SUD_Arabic-PADT/
assets_la/SUD_Latin-ITTB/
assets_la2/SUD_Latin-PROIEL/
assets_la/la_ittbproiel-sud-*.conllu
assets_sa/SUD_Sanskrit-Vedic/
assets_sa_ufal/SUD_Sanskrit-UFAL/
assets_lzh/SUD_Classical_Chinese-Kyoto/
assets_ja/SUD_Japanese-GSD/
assets_yue/SUD_Cantonese-HK/
# derived init_tok2vec weights (extracted from the zh_gsdboth model; regenerate via scripts/train_yue.sh notes)
zh_both_tok2vec.bin

# Macron lookup table: DERIVED FROM MORPHEUS (CC BY-SA 3.0) via the Alatius macroniser.
# Never committed and never shipped in a wheel -- build it locally with scripts/build_la_macron.sh.
# See NOTICE.md, "Latin macronisation".
scripts/la_macron_lut.json.gz
build_la_macron/

# DCS (Digital Corpus of Sanskrit, CC BY 4.0) — a 1.1 GB sparse clone used to train the sa
# CSLiser / morphologiser / lemmatiser / unsandhi. Re-fetch with:
#   git clone --filter=blob:none --no-checkout --depth 1 \
#       https://github.com/OliverHellwig/sanskrit.git assets_dcs
#   cd assets_dcs && git sparse-checkout set dcs/data/conllu/files && git checkout
assets_dcs/
# derived CSLiser training pairs (regenerate with make_samhita_pairs.py / dcs_to_samhita.py)
data_samhita/

# Latin vowel lengths: neither table is ours to redistribute (see NOTICE.md).
# The Morpheus cache normally lives in ~/.cache/sud-spacy/, but $LA_MORPHEUS_TABLE can put
# it anywhere — including here, which is what this line is for.
la_macron_morpheus.json.gz

# ---- Derived data and weights that are REGENERABLE, added 2026-08-04 ----------------------------
# Same rule as data_samhita/ above: anything a script rebuilds stays out of the repo. These had
# simply never been listed, so ~950 MB of them showed as untracked noise in every `git status`.

# Character-segmenter training pairs (regenerate: scripts/make_seg_pairs.py <treebank> <out>)
data_seg_zh/
data_seg_zh_trad/
data_seg_id/
data_seg_yue/
# Trained segmenters, pkuseg models, lexicons. These SHIP INSIDE THE WHEELS (the tokenizer/
# directory), so the release is the distribution channel, not the repo.
models/
# Derived treebank artefacts: the Latin ITTB+PROIEL+Perseus merges and their macron/relabel/reported
# variants (rebuild: scripts/add_perseus_la.sh, train_la_ext_macron.sh), the combined SUD dumps, and
# the Apte/CDSL extraction (scripts/build_apte_lexicon.py). Individually 56-71 MB each.
assets_la/
assets_sud/
assets_apte/
assets_ko_retok_rl/
assets_id_coarse_rl/
# English udep-ruled derivatives. en was SKIPPED for the udep-rule retrain (0.22 % of tokens), so
# these are experimental only; rebuild with scripts/apply_udep_rules.py.
assets/en_ewt-sud-*.udep_ruled.conllu
# Pre-transform backups, kept locally as an undo path for one-way rewrites
backup_la_preperseus/
backup_sa_prepipe/
backup_sa_prestrip/
# Superseded LLM decision caches from the abandoned multi-way residue pass (see the negative result)
archive_residue_pass1/
archive_residue_pass2/
# Extracted tok2vec weights for the sa joint arms (same rule as zh_both_tok2vec.bin above)
sa_joint_tok2vec.bin
sa_joint_tok2vec_w96.bin
dist_la_perseus/


# Kanripo editions: the punctuated Classical Chinese texts the lzh aligner reads.
# Re-fetch with scripts/fetch_kanripo.sh.
assets_kanripo/
corpus_sa_tokens.txt
corpus_sa_unsandhied.txt
corpus_sa_lemmas.txt
vectors_sa_*.vec
kanripo_repos.txt

# Latin orthography augmenter (scripts/la_orth.py) artefacts, both regenerable:
#   the glide lexicon -- which `u` spells the consonant, harvested from the v-writing treebanks
#   (rebuild: scripts/build_la_glide_lut.py; scripts/train_la_aug.sh does it automatically), and
#   the label sets a streamed corpus has to be handed (rebuild: scripts/train_la_aug.sh labels).
scripts/la_glide_lut.json.gz
labels_la_aug*/
build_lzh_eval_lut/

# floret vectors and the plain-text corpora they are trained from. Hundreds of MB, and every
# one is reproducible from the treebank by scripts/train_floret.sh. vectors_*_sem48/ is the
# PCA'd table configs/config_en_split48*.cfg reads.
vectors_*_floret/
vectors_*_floret.bin
vectors_*_floret.vec
vectors_*_sem48/
corpus_en_tokens.txt
corpus_la_tokens.txt

# Derived vocalisation tables, on the same footing as scripts/la_*_lut.json.gz: built by
# build_{ar,fa}_vocalise_lut.py, never bundled in a wheel and never committed. ar's is extracted
# from SUD_Arabic-PADT (CC BY-NC-SA 3.0) and fa's from the Tihu lexicon, so keeping them out of
# git is a licence position, not just hygiene.
scripts/ar_vocalise_lut.json.gz
scripts/fa_vocalise_lut.json.gz

# vidyut's linguistic data bundle (~100M generated Sanskrit word forms), downloaded by
# vidyut.download_data(). Never committed: it is a third-party redistribution whose licence is
# unresolved, and it is reproducible with one call.
vidyut-data/

# lzh kanripo vector artefacts (regenerate: make_leakfree_lzh_corpus.py -> build_lzh_vectors.py)
corpus_lzh_kanripo_leakfree*.txt
vectors_lzh_*.vec
vectors_lzh_leakfree*/
vectors_lzh_shuffled*/
build_lzh_vectors_leakfree.log
# CC0 Qieyun data, refetched by build_lzh_vectors.py (URL in its docstring)
assets_qieyun/
assets_cbeta/
assets_unihan/
assets_dila/
assets_soothill/
assets_wiktionary/

# Derived from vidyut (~100M forms) and the Heritage/Inria lexicon, on the same footing as
# scripts/{ar,fa}_vocalise_lut.json.gz: rebuildable with scripts/build_analyser_lexicon.py, and
# kept out of git because its licence is unresolved. The SHIPPED arm is runtime-mode and never
# reads it.
scripts/sa_analyser_lut.json.gz
corpus_sa_pmerged_raw/
corpus_sa_pmerged_norm/

# lemma-vector tables: build artefacts, rebuilt by build_lemma_vectors.py
scripts/*_lemmavec_*.npz
